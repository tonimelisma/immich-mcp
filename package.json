{
  "name": "immich-mcp",
  "version": "0.1.0",
  "description": "MCP server for Immich with sign-in by Immich email and password (OAuth 2.1), per-user scoped API keys and no delete",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --dir test",
    "test:e2e": "vitest run --dir e2e --testTimeout 60000 --hookTimeout 300000",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "author": "Toni Melisma",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@immich/sdk": "3.4.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "bin": {
    "immich-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tonimelisma/immich-mcp.git"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "immich",
    "mcp",
    "model-context-protocol",
    "oauth",
    "photos"
  ]
}
